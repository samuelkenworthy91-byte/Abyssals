{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dialogue",
  "type": "object",
  "required": [
    "id",
    "speaker_id",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "speaker_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
