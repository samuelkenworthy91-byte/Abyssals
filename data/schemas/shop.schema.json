{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shop",
  "type": "object",
  "required": [
    "id",
    "name",
    "location_id",
    "inventory"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "price"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
