{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "area",
  "type": "object",
  "required": [
    "id",
    "chapter",
    "region",
    "location",
    "location_id",
    "rate",
    "min_level",
    "max_level",
    "phase_1",
    "phase_2",
    "access"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        {
          "const": "Postgame"
        }
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "rate": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH"
      ]
    },
    "min_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "phase_1": {
      "enum": [
        "DAY",
        "PALE"
      ]
    },
    "phase_2": {
      "enum": [
        "NIGHT",
        "DARK"
      ]
    },
    "access": {
      "type": "string",
      "minLength": 1
    }
  }
}
