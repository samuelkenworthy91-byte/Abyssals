{
  "name": "abyssals",
  "private": true,
  "version": "0.2.0-civeton-corrected",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "vitest run",
    "validate:canon": "tsx tools/validate_dev.ts",
    "validate:dev": "tsx tools/validate_dev.ts",
    "validate:production": "tsx tools/validate_production.ts",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:apk": "npm run android:build:debug && echo \"APK at android/app/build/outputs/apk/debug/app-debug.apk\""
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
