{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abyssals Species",
  "type": "object",
  "required": [
    "id",
    "dex_number",
    "name",
    "base_stats",
    "types",
    "capture_rate"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "dex_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 187
    },
    "name": {
      "type": "string"
    },
    "base_stats": {
      "type": "object",
      "required": [
        "hp",
        "attack",
        "defence",
        "sp_attack",
        "sp_defence",
        "speed"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "capture_rate": {
      "type": "integer"
    },
    "evolution": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
