{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trainer",
  "type": "object",
  "required": [
    "id",
    "name",
    "class",
    "ai_tier",
    "team"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "class": {
      "type": "string"
    },
    "ai_tier": {
      "type": "string"
    },
    "team": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "species_id",
          "level"
        ],
        "properties": {
          "species_id": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "moves": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "held_item_role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
